# ---------------------------------------------------------------------------
# Stage 15 — missingness_imputation_gate   [gated by stage 3]
# ---------------------------------------------------------------------------
rule missingness_imputation_gate:
    input:
        approval     = "results/approvals/dataset_audit_approved.json",
        outlier_done = "results/outlier_audit.csv",
    output:
        missingness_audit = "results/missingness_audit.csv",
        imputation_audit  = "results/imputation_audit.csv",
        method            = "results/missingness_method.json",
    log:
        "logs/missingness_imputation_gate.log"
    shell:
        """
        python workers/python/missingness_imputation_gate.py \
            --config config.yaml \
            --approval {input.approval} \
            --out-missingness {output.missingness_audit} \
            --out-imputation {output.imputation_audit} \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 16 — qc_approval  (produces the second gate artifact)
# ---------------------------------------------------------------------------
rule qc_approval:
    input:
        sample_qc          = "results/sample_qc_audit.csv",
        feature_qc         = "results/feature_qc_audit.csv",
        outlier_audit      = "results/outlier_audit.csv",
        missingness_audit  = "results/missingness_audit.csv",
        imputation_audit   = "results/imputation_audit.csv",
        qc_method          = "results/qc_method.json",
        sc_method          = "results/sc_method.json",
    output:
        approval = "results/approvals/qc_approved.json",
    log:
        "logs/qc_approval.log"
    shell:
        """
        python workers/python/qc_approval.py \
            --config config.yaml \
            --sample-qc {input.sample_qc} \
            --feature-qc {input.feature_qc} \
            --outlier-audit {input.outlier_audit} \
            --missingness-audit {input.missingness_audit} \
            --imputation-audit {input.imputation_audit} \
            --out-approval {output.approval} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 17 — differential_expression   [gated by stage 16]
# ---------------------------------------------------------------------------
rule differential_expression:
    input:
