{
  "name": "omics-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "AI-assisted omics desktop shell — React renderer + Electron main process",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "app": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "ai.omics.desktop",
    "productName": "Omics Desktop",
    "files": ["dist/**", "dist-electron/**"],
    "extraResources": [
      { "from": "../backend/dist/omics-backend", "to": "backend" }
    ],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.medical" },
    "linux": { "target": ["AppImage"] },
    "publish": { "provider": "github", "owner": "ohbryt", "repo": "omics" }
  }
}
