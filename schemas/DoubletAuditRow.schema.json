{
  "$defs": {
    "QCDecision": {
      "enum": [
        "PASS",
        "FLAG",
        "EXCLUDE",
        "CANDIDATE"
      ],
      "title": "QCDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cell_id": {
      "title": "Cell Id",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "expected_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Rate"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold"
    },
    "decision": {
      "$ref": "#/$defs/QCDecision"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "cell_id",
    "sample_id",
    "tool",
    "tool_version",
    "decision"
  ],
  "title": "DoubletAuditRow",
  "type": "object"
}