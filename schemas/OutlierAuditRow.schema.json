{
  "$defs": {
    "QCDecision": {
      "enum": [
        "PASS",
        "FLAG",
        "EXCLUDE",
        "CANDIDATE"
      ],
      "title": "QCDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "metric_or_method": {
      "title": "Metric Or Method",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold"
    },
    "decision": {
      "$ref": "#/$defs/QCDecision"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "candidate_only": {
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "approved": {
      "default": false,
      "title": "Approved",
      "type": "boolean"
    }
  },
  "required": [
    "entity_id",
    "metric_or_method",
    "decision"
  ],
  "title": "OutlierAuditRow",
  "type": "object"
}