# =============================================================================
# Snakemake workflow — AI-Assisted Omics Pipeline (SPEC.md §7, 20 stages)
#
# Run from repo root:
#   snakemake -s workflows/snakemake/Snakefile --cores <N>
#
# Interactive mode: the pipeline stops at two human-approval gates:
#   1. results/approvals/dataset_audit_approved.json  (stage 3)
#      — blocks fetch_raw and ALL QC stages (stages 4-15)
#   2. results/approvals/qc_approved.json             (stage 16)
#      — blocks differential_expression and integration (stages 17-18)
#
# Autonomous mode: pre-create approval artifacts externally (e.g., via the
# FastAPI backend /projects/{id}/approvals endpoint) before invoking Snakemake.
#
# Approval gating is enforced via DAG input dependencies — Snakemake will
# refuse to run any downstream rule until the approval artifact exists.
# final_verifier (stage 20) writes results/run_status.json and exits non-zero
# on STATUS=BLOCKED, failing the workflow loudly.
# =============================================================================

configfile: "config.yaml"

# ---------------------------------------------------------------------------
# Terminal target
# ---------------------------------------------------------------------------
rule all:
    input:
        "results/run_status.json"


# ---------------------------------------------------------------------------
# Stage 1 — detect_modality
# ---------------------------------------------------------------------------
rule detect_modality:
    output:
        audit   = "results/modality_detected.csv",
        method  = "results/detect_modality_method.json",
    log:
        "logs/detect_modality.log"
    shell:
        """
        python workers/python/detect_modality.py \
            --config config.yaml \
            --out-audit {output.audit} \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 2 — dataset_selection_gate
# ---------------------------------------------------------------------------
rule dataset_selection_gate:
    input:
        modality = "results/modality_detected.csv",
    output:
        audit   = "results/dataset_audit.csv",
        method  = "results/dataset_selection_method.json",
    log:
        "logs/dataset_selection_gate.log"
    shell:
        """
        python workers/python/dataset_selection_gate.py \
            --config config.yaml \
            --modality {input.modality} \
            --out-audit {output.audit} \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 3 — dataset_audit_approval  (produces the gate artifact)
# ---------------------------------------------------------------------------
rule dataset_audit_approval:
    input:
        audit   = "results/dataset_audit.csv",
        method  = "results/dataset_selection_method.json",
    output:
        approval = "results/approvals/dataset_audit_approved.json",
    log:
        "logs/dataset_audit_approval.log"
    shell:
        """
        python workers/python/dataset_audit_approval.py \
            --config config.yaml \
            --audit {input.audit} \
            --out-approval {output.approval} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 4 — fetch_raw   [gated by stage 3]
# ---------------------------------------------------------------------------
rule fetch_raw:
    input:
        approval = "results/approvals/dataset_audit_approved.json",
        audit    = "results/dataset_audit.csv",
    output:
        checksums = "data/CHECKSUMS.txt",
    log:
        "logs/fetch_raw.log"
    shell:
        """
        python workers/python/fetch_raw.py \
            --config config.yaml \
            --audit {input.audit} \
            --approval {input.approval} \
            --out-checksums {output.checksums} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 5 — sample_qc_gate   [gated by stage 3]
# Note: method output is results/qc_method.json (SPEC §7 exact name)
# ---------------------------------------------------------------------------
rule sample_qc_gate:
    input:
        approval  = "results/approvals/dataset_audit_approved.json",
        checksums = "data/CHECKSUMS.txt",
    output:
        audit   = "results/sample_qc_audit.csv",
        method  = "results/qc_method.json",
    log:
        "logs/sample_qc_gate.log"
    shell:
        """
        python workers/python/sample_qc_gate.py \
            --config config.yaml \
            --approval {input.approval} \
            --out-audit {output.audit} \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 6 — feature_qc_gate   [gated by stage 3]
# ---------------------------------------------------------------------------
rule feature_qc_gate:
    input:
        approval       = "results/approvals/dataset_audit_approved.json",
        sample_qc_done = "results/sample_qc_audit.csv",
    output:
        audit   = "results/feature_qc_audit.csv",
        method  = "results/feature_qc_method.json",
    log:
        "logs/feature_qc_gate.log"
    shell:
        """
        python workers/python/feature_qc_gate.py \
            --config config.yaml \
            --approval {input.approval} \
            --out-audit {output.audit} \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 7 — bulk_process   [gated by stage 3]
# ---------------------------------------------------------------------------
rule bulk_process:
    input:
        approval       = "results/approvals/dataset_audit_approved.json",
        sample_qc_done = "results/sample_qc_audit.csv",
        feature_qc_done = "results/feature_qc_audit.csv",
    output:
        dir_sentinel = directory("results/bulk"),
        method       = "results/bulk_method.json",
    log:
        "logs/bulk_process.log"
    shell:
        """
        python workers/python/bulk_process.py \
            --config config.yaml \
            --approval {input.approval} \
            --out-dir results/bulk \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 8 — microarray_process   [gated by stage 3]
# ---------------------------------------------------------------------------
rule microarray_process:
    input:
        approval        = "results/approvals/dataset_audit_approved.json",
        sample_qc_done  = "results/sample_qc_audit.csv",
        feature_qc_done = "results/feature_qc_audit.csv",
    output:
        dir_sentinel = directory("results/microarray"),
        method       = "results/microarray_method.json",
    log:
        "logs/microarray_process.log"
    shell:
        """
        Rscript workers/r/microarray_process.R \
            --config config.yaml \
            --approval {input.approval} \
            --out-dir results/microarray \
            --out-method {output.method} \
            > {log} 2>&1
        """


