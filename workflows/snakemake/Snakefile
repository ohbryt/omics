            --out-dir results/de \
            --out-audit {output.audit} \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 18 — integration   [gated by stage 16]
# ---------------------------------------------------------------------------
rule integration:
    input:
        approval  = "results/approvals/qc_approved.json",
