            --out-dir results/integration \
            --out-method {output.method} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 19 — checksums  (covers result tables, independent of approval gates)
# ---------------------------------------------------------------------------
rule checksums:
    input:
        dataset_audit     = "results/dataset_audit.csv",
        modality          = "results/modality_detected.csv",
        sample_qc         = "results/sample_qc_audit.csv",
        feature_qc        = "results/feature_qc_audit.csv",
        outlier_audit     = "results/outlier_audit.csv",
        missingness_audit = "results/missingness_audit.csv",
        imputation_audit  = "results/imputation_audit.csv",
        de_audit          = "results/de/de_audit.csv",
        raw_checksums     = "data/CHECKSUMS.txt",
    output:
        checksums = "results/CHECKSUMS.txt",
    log:
        "logs/checksums.log"
    shell:
        """
        python workers/python/checksums.py \
            --config config.yaml \
            --inputs \
                {input.dataset_audit} \
                {input.modality} \
                {input.sample_qc} \
                {input.feature_qc} \
                {input.outlier_audit} \
                {input.missingness_audit} \
                {input.imputation_audit} \
                {input.de_audit} \
            --out-checksums {output.checksums} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Stage 20 — final_verifier  (exits non-zero on BLOCKED)
# ---------------------------------------------------------------------------
rule final_verifier:
    input:
        run_config        = "config.yaml",
        modality          = "results/modality_detected.csv",
        dataset_audit     = "results/dataset_audit.csv",
        dataset_approval  = "results/approvals/dataset_audit_approved.json",
        sample_qc         = "results/sample_qc_audit.csv",
        feature_qc        = "results/feature_qc_audit.csv",
        outlier_audit     = "results/outlier_audit.csv",
        missingness_audit = "results/missingness_audit.csv",
        imputation_audit  = "results/imputation_audit.csv",
        qc_approval       = "results/approvals/qc_approved.json",
        de_audit          = "results/de/de_audit.csv",
        checksums         = "results/CHECKSUMS.txt",
    output:
        run_status = "results/run_status.json",
    log:
        "logs/final_verifier.log"
    shell:
        """
        python scripts/verify.py \
            --config config.yaml \
            --out-status {output.run_status} \
            > {log} 2>&1
        """
